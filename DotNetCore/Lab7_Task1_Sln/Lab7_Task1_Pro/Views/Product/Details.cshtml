
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>


<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Id</td>
            <td>@Model.Name</td>
            <td>@Model.Price</td>
            <td>@Model.Category</td>
        </tr>
    </tbody>
</table>