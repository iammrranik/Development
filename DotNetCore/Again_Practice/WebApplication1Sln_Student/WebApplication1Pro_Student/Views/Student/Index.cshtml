    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@* @Model.Cgpa *@

<html>
    <head>
        <h1>Index Page for Student List Table</h1>
    </head>
    <body>
        <table class="table table-bordered">
            <thead class="table-primary">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Age</th>
                    <th>Department</th>
                    <th>CGPA</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody class="table-secondary">
                @foreach(var student in Model)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.Name</td>
                        <td>@student.Age</td>
                        <td>@student.Department</td>
                        <td>@student.Cgpa.ToString("F2")</td>
                        <td>
                            <a class="btn btn-primary" href="/student/details/@student.Id" target="_blank">Details @student.Id</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </body>
</html>

