@{
}

<html>
<head>
    <h1>Details Page for Student List Table</h1>
</head>
<body>
    <table class="table table-bordered">
        <thead class="table-primary">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Age</th>
                <th>Department</th>
                <th>CGPA</th>
            </tr>
        </thead>
        <tbody class="table-secondary">
                <tr>
                    <td>@Model.Id</td>
                    <td>@Model.Name</td>
                    <td>@Model.Age</td>
                    <td>@Model.Department</td>
                    <td>@Model.Cgpa.ToString("F2")</td>
                </tr>
        </tbody>
    </table>
</body>
</html>